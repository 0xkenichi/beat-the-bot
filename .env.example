# Copy to .env (never committed). Kenichi creates every key himself; nobody else ever sees them.

# Base RPC (Alchemy or any Base mainnet endpoint): stocks, prices, swaps. Public endpoints work but are rate-limited.
BASE_RPC_URL=

# The league contracts' chain: 84532 (Base Sepolia, the $0 path) or 8453 (Base). Usually left empty:
# `pnpm admin deployments` records it in shared/src/deployments.json. CONTRACTS_RPC_URL is optional (public RPC otherwise).
CONTRACTS_CHAIN_ID=
CONTRACTS_RPC_URL=

# Postgres (Neon free tier via Vercel Storage works). Local runs can use pglite:./data/local
DATABASE_URL=

# Builder Code from base.dev (public; can live in shared/src/deployments.json instead)
BUILDER_CODE=

# Keys: create with `pnpm admin new-wallets` (writes them here, prints only addresses)
OWNER_PRIVATE_KEY=
RESOLVER_PRIVATE_KEY=
SPONSOR_PRIVATE_KEY=
BOT_MOMENTUM_PRIVATE_KEY=
BOT_CONTRARIAN_PRIVATE_KEY=
BOT_STEADY_PRIVATE_KEY=

# Web app (Vercel env)
NEXT_PUBLIC_SITE_URL=
SESSION_SECRET=
# CDP Paymaster URLs: Base Sepolia for free play, Base for real-money trades (see docs/runbook.md)
PAYMASTER_URL_SEPOLIA=
PAYMASTER_URL=
TRADE_MODE=

# Scheduler (jobs deployment only): JOBS_ENABLED=1 turns on /api/cron/tick; the cron sends Authorization: Bearer <CRON_SECRET>
JOBS_ENABLED=
CRON_SECRET=

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_GROUP_CHAT_ID=
TELEGRAM_WEBHOOK_SECRET=

# House bots: "picks" (lock three picks a week; default when the contracts are on Base Sepolia) or "trade" (real money)
BOTS_MODE=

# Steady bot (optional, any OpenAI-compatible free tier). Without these, Steady holds every stock equally.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# Contract verification on Basescan, funded path only (Etherscan API key, free). Base Sepolia uses Blockscout, no key.
BASESCAN_API_KEY=
